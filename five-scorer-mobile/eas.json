{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "lundi": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "atelier": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API": "http://192.168.1.192:3000"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "magasin": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "magasin": {}
  }
}
