generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// Auth — schéma généré par Better Auth (plugin organization).
// Une Organization EST un club ; le profil sportif vit dans `Club` (1:1).
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  motmVotes     MotmVote[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  /// Better Auth ≥1.7 : l'identité d'un account est scopée par issuer
  /// (ex. "local:credential" pour email/mot de passe).
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  club        Club?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ═══════════════════════════════════════════════════════════════════════════
// Domaine — tout est scopé par club (clubId = organization.id).
// ═══════════════════════════════════════════════════════════════════════════

enum SportFormat {
  FIVE
  FUTSAL
  SEVEN
  ELEVEN
  OTHER
}

enum MotmMode {
  VOTE // les membres votent après le match
  ADMIN // le marqueur/admin désigne
  OFF
}

/// Profil sportif du club (1:1 avec Organization).
model Club {
  id               String       @id // == organization.id
  organization     Organization @relation(fields: [id], references: [id], onDelete: Cascade)
  format           SportFormat  @default(FIVE)
  /// Durée par défaut d'un match en minutes (les fives jouent souvent 2×10 ou au temps).
  matchDurationMin Int          @default(10)
  pointsWin        Int          @default(3)
  pointsDraw       Int          @default(1)
  trackAssists     Boolean      @default(true)
  trackCards       Boolean      @default(false)
  motmMode         MotmMode     @default(VOTE)
  /// Les membres (rôle member) peuvent-ils saisir en live ? Sinon admin+ uniquement.
  membersCanScore  Boolean      @default(true)
  /// Couleurs des chasubles — l'identité visuelle du club. L'app est
  /// neutre ; ce sont ces deux couleurs qui l'habillent (barres d'équipe,
  /// scores, classements). La variante lisible pour le texte est dérivée
  /// par le calcul, pas stockée (cf. lib/color.ts).
  colorA           String       @default("#FF6B2C")
  colorB           String       @default("#3D8BFF")
  /// Page club publique (/p/[slug]) : classements + résultats en lecture seule.
  isPublic         Boolean      @default(false)
  /// Code d'invitation court, régénérable (rejoindre sans email).
  inviteCode       String       @unique @default(cuid())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  players   Player[]
  seasons   Season[]
  matchDays MatchDay[]
  opponents Opponent[]
  matches   Match[]

  @@map("club")
}

model Player {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name       String
  nickname   String?
  /// La photo du joueur, en data-URL JPEG carrée de 256 px (~20 ko).
  ///
  /// Stockée dans la base plutôt que sur un service de fichiers : un club de
  /// quinze joueurs, c'est trois cents kilo-octets. Un bucket, c'est un
  /// compte de plus, une clé de plus, une panne de plus — pour la même image.
  /// Le redimensionnement se fait sur le téléphone avant l'envoi.
  photo      String?  @db.Text
  /// Compte utilisateur lié (un membre peut revendiquer son profil joueur).
  userId     String?
  /// Note de niveau 1..5, réglée par les admins — alimente le générateur d'équipes.
  skill      Int      @default(3)
  /// Gardien attitré (le générateur répartit les GK en premier).
  isGk       Boolean  @default(false)
  isGuest    Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  participations MatchParticipant[]
  lineups        MatchDayLineup[]
  events         MatchEvent[]       @relation("EventPlayer")
  assists        MatchEvent[]       @relation("EventAssist")
  mvpOfMatches   Match[]            @relation("MatchMvp")
  motmVotes      MotmVote[]
  rsvps          Rsvp[]

  @@unique([clubId, userId])
  @@index([clubId, isArchived])
  @@index([clubId, name])
  @@map("player")
}

model Season {
  id        String    @id @default(cuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  matches   Match[]
  matchDays MatchDay[]

  @@index([clubId, isActive])
  @@map("season")
}

/// Une "session" : la soirée five, qui regroupe plusieurs petits matchs
/// et porte les présences (RSVP).
model MatchDay {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  seasonId       String?
  season         Season?   @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  date           DateTime
  title          String?
  location       String?
  notes          String?
  /// Prix du terrain en centimes — réparti entre les présents (paiements).
  fieldCostCents Int?
  /// Soirée annulée (terrain fermé, vacances, trop peu de monde). On ne
  /// supprime pas : un calendrier généré pour la saison doit garder la trace
  /// de ce qui n'a pas eu lieu, sinon on le régénère et le trou revient.
  canceledAt     DateTime?
  cancelReason   String?
  /// Noms des deux équipes de la soirée. Nuls tant que la compo n'est pas
  /// préparée ; les matchs retombent alors sur les noms par défaut du club.
  teamAName      String?
  teamBName      String?
  createdAt      DateTime  @default(now())

  matches Match[]
  rsvps   Rsvp[]
  lineup  MatchDayLineup[]

  @@index([clubId, date])
  @@map("match_day")
}

/// La composition PRÉPARÉE d'une soirée.
///
/// Le club connaît ses équipes trois à quatre jours avant de jouer. Elles
/// n'avaient nulle part où être écrites : il fallait attendre le coup d'envoi
/// et composer debout au bord du terrain. La compo vit donc sur la soirée, pas
/// sur un match — une soirée enchaîne quatre à huit matchs avec les deux mêmes
/// équipes, et chacun en hérite.
model MatchDayLineup {
  matchDayId String
  matchDay   MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team       Team
  isGk       Boolean  @default(false)

  @@id([matchDayId, playerId])
  @@index([playerId])
  @@map("match_day_lineup")
}

/// Équipe adverse externe (mode championnat / matchs contre d'autres équipes).
model Opponent {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  shortName String?
  createdAt DateTime @default(now())

  matches Match[]

  @@unique([clubId, name])
  @@map("opponent")
}

enum MatchKind {
  /// Match interne : deux équipes tirées du roster du club (le five classique).
  INTERNAL
  /// Match contre une équipe externe (Opponent) — alimente le classement.
  EXTERNAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELED
}

enum Team {
  A
  B
}

model Match {
  id          String      @id @default(cuid())
  clubId      String
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  seasonId    String?
  season      Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  matchDayId  String?
  matchDay    MatchDay?   @relation(fields: [matchDayId], references: [id], onDelete: SetNull)
  kind        MatchKind   @default(INTERNAL)
  opponentId  String?
  opponent    Opponent?   @relation(fields: [opponentId], references: [id], onDelete: SetNull)
  /// Match EXTERNAL : joué à domicile ?
  isHome      Boolean     @default(true)
  status      MatchStatus @default(LIVE)
  scheduledAt DateTime?
  playedAt    DateTime    @default(now())
  venue       String?
  teamAName   String      @default("Équipe A")
  teamBName   String      @default("Équipe B")
  /// Scores dénormalisés — recalculés depuis les events à chaque mutation.
  scoreA      Int         @default(0)
  scoreB      Int         @default(0)
  durationMin Int?
  mvpId       String?
  mvp         Player?     @relation("MatchMvp", fields: [mvpId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  participants MatchParticipant[]
  events       MatchEvent[]
  motmVotes    MotmVote[]
  rsvps        Rsvp[]

  @@index([clubId, playedAt])
  @@index([clubId, status])
  @@index([seasonId])
  @@index([matchDayId])
  @@map("match")
}

model MatchParticipant {
  matchId     String
  playerId    String
  /// Équipe COURANTE — celle qu'on voit à l'écran, modifiable en cours de match.
  team        Team
  /// Équipe au coup d'envoi, écrite une fois et jamais retouchée.
  ///
  /// Les statistiques lisaient `team`, donc l'équipe de FIN de match : un
  /// joueur qui commençait chez les perdants, marquait deux buts et changeait
  /// de camp ressortait avec une victoire, un gain d'Élo, et ses propres buts
  /// étiquetés dans l'autre équipe. Les agrégats lisent désormais celle-ci.
  initialTeam Team
  isGk        Boolean @default(false)

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([matchId, playerId])
  @@index([playerId])
  @@map("match_participant")
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  /// Marqueur de mi-temps dans la timeline (aucun effet sur le score).
  HALF_TIME
}

model MatchEvent {
  id             String         @id @default(cuid())
  matchId        String
  match          Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type           MatchEventType
  /// Équipe créditée (pour un but : celle qui marque, y compris sur csc).
  team           Team
  /// Joueur concerné — null possible (ex. buteur adverse inconnu en EXTERNAL).
  playerId       String?
  player         Player?        @relation("EventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  assistPlayerId String?
  assistPlayer   Player?        @relation("EventAssist", fields: [assistPlayerId], references: [id], onDelete: SetNull)
  minute         Int?
  createdAt      DateTime       @default(now())

  @@index([matchId, createdAt])
  @@index([playerId])
  @@index([assistPlayerId])
  @@map("match_event")
}

enum RsvpStatus {
  IN
  OUT
  MAYBE
}

/// Présence : sur une session (MatchDay) ou un match programmé.
model Rsvp {
  id          String     @id @default(cuid())
  matchDayId  String?
  matchDay    MatchDay?  @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  matchId     String?
  match       Match?     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status      RsvpStatus
  /// A payé sa part du terrain (coché par un admin sur la session).
  hasPaid     Boolean    @default(false)
  respondedAt DateTime   @updatedAt

  @@unique([matchDayId, playerId])
  @@unique([matchId, playerId])
  @@map("rsvp")
}

model MotmVote {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voterId   String
  voter     User     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([matchId, voterId])
  @@index([matchId])
  @@map("motm_vote")
}
